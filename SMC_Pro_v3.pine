//@version=6

indicator("SMC Pro v3", "SMC Pro v3", overlay = true, max_lines_count = 500, max_boxes_count = 300, max_labels_count = 300)

// ============================================================================
// SMC Pro v3 — price-chart overlay
//
// Visual philosophy:
//   • Structure is drawn directly on the candles.
//   • Broken structure is shown as a thin line from the broken swing to the
//     breaker candle, with a tiny transparent event label at the midpoint.
//   • Labels describe what happened instead of exposing implementation terms.
//   • Zones remain attached to price: FVG, Order Block and protected levels.
//   • Retests are post-break state events, not same-candle conditions.
// ============================================================================

// ----------------------------- Inputs ---------------------------------------
gStructure = "01. Market Structure"
pivotLen = input.int(2, "Swing sensitivity", minval = 1, maxval = 10, group = gStructure)
confirmMode = input.string("Close", "Break confirmation", options = ["Close", "Wick"], group = gStructure)
atrLen = input.int(14, "ATR length", minval = 1, group = gStructure)
breakAtr = input.float(0.10, "Break buffer", minval = 0, step = 0.01, group = gStructure)
showStructure = input.bool(true, "Show structure", group = gStructure)
showSwingPoints = input.bool(false, "Show swing points", group = gStructure)
maxStructure = input.int(100, "Structure history", minval = 20, maxval = 200, group = gStructure)
labelMode = input.string("Descriptive", "Label style", options = ["Compact", "Descriptive"], group = gStructure, tooltip = "Compact uses BOS/CHoCH/EQH/EQL. Descriptive uses plain-language labels.")

// ----------------------------- Retest ---------------------------------------
gRetest = "02. Structure Retest"
showRetest = input.bool(true, "Show retests", group = gRetest)
retestToleranceAtr = input.float(0.20, "Retest zone tolerance", minval = 0, step = 0.01, group = gRetest)
retestInvalidAtr = input.float(0.20, "Retest invalidation", minval = 0, step = 0.01, group = gRetest)
retestMaxBars = input.int(30, "Retest window", minval = 1, maxval = 200, group = gRetest)
requireRejection = input.bool(true, "Require rejection close", group = gRetest)
showProtected = input.bool(true, "Show protected level", group = gRetest)

// ----------------------------- FVG ------------------------------------------
gFvg = "03. Fair Value Gaps"
showFvg = input.bool(true, "Show FVGs", group = gFvg)
fvgMinAtr = input.float(0.10, "Minimum FVG size", minval = 0, step = 0.01, group = gFvg)
fvgExtend = input.int(30, "FVG extension", minval = 1, maxval = 200, group = gFvg)
removeFilledFvg = input.bool(true, "Remove filled FVGs", group = gFvg)
showFvgLabel = input.bool(true, "Label FVGs", group = gFvg)

// ----------------------------- Order Blocks ---------------------------------
gOb = "04. Order Blocks"
showOb = input.bool(true, "Show order blocks", group = gOb)
obLookback = input.int(12, "OB search window", minval = 1, maxval = 50, group = gOb)
obImpulseAtr = input.float(0.50, "Minimum displacement", minval = 0, step = 0.05, group = gOb)
obExtend = input.int(40, "OB extension", minval = 1, maxval = 200, group = gOb)
showObLabel = input.bool(true, "Label order blocks", group = gOb)

// ----------------------------- Liquidity ------------------------------------
gLiquidity = "05. Liquidity"
showLiquidity = input.bool(true, "Show liquidity", group = gLiquidity)
showSweeps = input.bool(true, "Show liquidity sweeps", group = gLiquidity)
eqToleranceAtr = input.float(0.12, "Equal high/low tolerance", minval = 0, step = 0.01, group = gLiquidity)
liqMaxAge = input.int(150, "Maximum liquidity age", minval = 10, maxval = 1000, group = gLiquidity)

// ----------------------------- Dealing range --------------------------------
gRange = "06. Dealing Range"
showRange = input.bool(true, "Show equilibrium", group = gRange)
showZones = input.bool(false, "Shade premium / discount", group = gRange)

// ----------------------------- Visuals ---------------------------------------
colBull = color.rgb(38, 166, 91)
colBear = color.rgb(239, 83, 80)
colStructure = color.rgb(255, 152, 0)
colNeutral = color.rgb(120, 123, 134)
colFvgBull = color.rgb(0, 188, 212)
colFvgBear = color.rgb(171, 71, 188)
colObBull = color.rgb(38, 166, 91)
colObBear = color.rgb(239, 83, 80)

atr = ta.atr(atrLen)
safeAtr = math.max(nz(atr, syminfo.mintick), syminfo.mintick)
confirmed = barstate.isconfirmed

breakUp(float level) =>
    confirmMode == "Close" ? close > level + safeAtr * breakAtr : high > level + safeAtr * breakAtr

breakDn(float level) =>
    confirmMode == "Close" ? close < level - safeAtr * breakAtr : low < level - safeAtr * breakAtr

fmt(string compact, string descriptive) =>
    labelMode == "Compact" ? compact : descriptive

// ============================================================================
// Types
// ============================================================================
type Swing
    float price
    int time
    int index
    bool broken
    bool protected
    bool invalidated
    int breakIndex
    int breakTime
    float breakPrice

type Zone
    box id
    float top
    float bottom
    int born
    bool bullish
    bool active

type Pool
    line id
    float price
    int born
    bool highPool
    bool swept
    bool active

// ============================================================================
// State
// ============================================================================
var array<Swing> highs = array.new<Swing>()
var array<Swing> lows = array.new<Swing>()
var array<Zone> fvgZones = array.new<Zone>()
var array<Zone> obZones = array.new<Zone>()
var array<Pool> pools = array.new<Pool>()

var int bias = 0
var float protectedLevel = na
var int protectedIndex = na
var int protectedBreakIndex = na
var int retestState = 0
var int retestStartIndex = na
var bool retestTouched = false
var int lastRetestLabelIndex = na

var float dealingHigh = na
var float dealingLow = na
var line equilibriumLine = na

// ============================================================================
// Confirmed swing ingestion
// ============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if confirmed and not na(ph)
    array.unshift(highs, Swing.new(ph, time[pivotLen], bar_index - pivotLen, false, false, false, na, na, na))
    if array.size(highs) > maxStructure
        array.pop(highs)

if confirmed and not na(pl)
    array.unshift(lows, Swing.new(pl, time[pivotLen], bar_index - pivotLen, false, false, false, na, na, na))
    if array.size(lows) > maxStructure
        array.pop(lows)

// ============================================================================
// Structure event detection
// ============================================================================
bosUp = false
bosDn = false
chochUp = false
chochDn = false

// Store the exact broken swing so the visual can be drawn from the pivot to
// the breaker candle without placing a large label on the breaker.
float brokenHighPrice = na
int brokenHighTime = na
float brokenLowPrice = na
int brokenLowTime = na

highBreak = false
lowBreak = false
int highAge = na
int lowAge = na

if confirmed and array.size(highs) > 0
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if not s.broken and not s.invalidated and breakUp(s.price)
            highBreak := true
            highAge := bar_index - s.index
            break

if confirmed and array.size(lows) > 0
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if not s.broken and not s.invalidated and breakDn(s.price)
            lowBreak := true
            lowAge := bar_index - s.index
            break

// If both sides break on one confirmed candle, process the older pivot first.
processHigh = highBreak and (not lowBreak or highAge <= lowAge)
processLow = lowBreak and (not highBreak or lowAge < highAge)

if processHigh
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if not s.broken and not s.invalidated and breakUp(s.price)
            brokenHighPrice := s.price
            brokenHighTime := s.time
            s.broken := true
            s.breakIndex := bar_index
            s.breakTime := time
            s.breakPrice := confirmMode == "Close" ? close : high
            array.set(highs, i, s)
            bosUp := true
            chochUp := bias < 0
            bias := 1
            break

if processLow
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if not s.broken and not s.invalidated and breakDn(s.price)
            brokenLowPrice := s.price
            brokenLowTime := s.time
            s.broken := true
            s.breakIndex := bar_index
            s.breakTime := time
            s.breakPrice := confirmMode == "Close" ? close : low
            array.set(lows, i, s)
            bosDn := true
            chochDn := bias > 0
            bias := -1
            break

// ============================================================================
// Protected swing and retest state
// ============================================================================
if bosUp
    protectedLevel := na
    protectedIndex := na
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if s.time < time and not s.invalidated
            protectedLevel := s.price
            protectedIndex := s.index
            s.protected := true
            array.set(lows, i, s)
            break
    protectedBreakIndex := bar_index
    retestState := not na(protectedLevel) ? 1 : 0
    retestStartIndex := bar_index
    retestTouched := false

if bosDn
    protectedLevel := na
    protectedIndex := na
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if s.time < time and not s.invalidated
            protectedLevel := s.price
            protectedIndex := s.index
            s.protected := true
            array.set(highs, i, s)
            break
    protectedBreakIndex := bar_index
    retestState := not na(protectedLevel) ? -1 : 0
    retestStartIndex := bar_index
    retestTouched := false

// Retest is deliberately post-break only. A wick can enter the retest zone
// without requiring an exact tick touch of the protected price.
retestLong = false
retestShort = false

if confirmed and retestState != 0 and bar_index > retestStartIndex
    barsInWindow = bar_index - retestStartIndex
    tolerance = safeAtr * retestToleranceAtr
    invalidation = safeAtr * retestInvalidAtr

    invalidLong = close < protectedLevel - invalidation
    invalidShort = close > protectedLevel + invalidation

    if barsInWindow > retestMaxBars or (retestState == 1 and invalidLong) or (retestState == -1 and invalidShort)
        retestState := 0
    else if retestState == 1
        touched = low <= protectedLevel + tolerance and low >= protectedLevel - invalidation
        if touched
            retestTouched := true
        rejected = not requireRejection or close > protectedLevel
        if retestTouched and rejected
            retestLong := true
            retestState := 0
    else
        touched = high >= protectedLevel - tolerance and high <= protectedLevel + invalidation
        if touched
            retestTouched := true
        rejected = not requireRejection or close < protectedLevel
        if retestTouched and rejected
            retestShort := true
            retestState := 0

// Protect against a completed structural invalidation even when no retest is
// pending. The protected swing remains a historical fact but loses its status.
if confirmed and bias == 1 and not na(protectedLevel) and breakDn(protectedLevel)
    if not na(protectedIndex)
        for i = 0 to array.size(lows) - 1
            s = array.get(lows, i)
            if s.index == protectedIndex
                s.invalidated := true
                s.protected := false
                array.set(lows, i, s)
                break
    if retestState == 1
        retestState := 0

if confirmed and bias == -1 and not na(protectedLevel) and breakUp(protectedLevel)
    if not na(protectedIndex)
        for i = 0 to array.size(highs) - 1
            s = array.get(highs, i)
            if s.index == protectedIndex
                s.invalidated := true
                s.protected := false
                array.set(highs, i, s)
                break
    if retestState == -1
        retestState := 0

// ============================================================================
// Structure visuals — minimal horizontal broken-price lines.
// ============================================================================
// The line starts at the actual confirmed swing and ends on the candle that
// broke it. The tiny transparent label sits at the midpoint, keeping the
// chart readable while preserving the BOS/CHoCH information.
if showStructure and bosUp and not na(brokenHighPrice) and not na(brokenHighTime)
    structureColor = chochUp ? colStructure : colBull
    line.new(brokenHighTime, brokenHighPrice, time, brokenHighPrice, xloc = xloc.bar_time, color = structureColor, width = 1)
    midTime = int(math.round((brokenHighTime + time) / 2.0))
    txt = chochUp ? fmt("CHoCH", "Bullish CHoCH") : fmt("BOS", "Bullish BOS")
    label.new(midTime, brokenHighPrice, txt, xloc = xloc.bar_time, style = label.style_none, color = color.new(structureColor, 100), textcolor = structureColor, size = size.tiny)

if showStructure and bosDn and not na(brokenLowPrice) and not na(brokenLowTime)
    structureColor = chochDn ? colStructure : colBear
    line.new(brokenLowTime, brokenLowPrice, time, brokenLowPrice, xloc = xloc.bar_time, color = structureColor, width = 1)
    midTime = int(math.round((brokenLowTime + time) / 2.0))
    txt = chochDn ? fmt("CHoCH", "Bearish CHoCH") : fmt("BOS", "Bearish BOS")
    label.new(midTime, brokenLowPrice, txt, xloc = xloc.bar_time, style = label.style_none, color = color.new(structureColor, 100), textcolor = structureColor, size = size.tiny)

if showRetest and retestLong and lastRetestLabelIndex != bar_index
    label.new(bar_index, low, fmt("RETEST ↑", "Bullish Retest"), style = label.style_label_up, color = colBull, textcolor = color.white, size = size.tiny)
    lastRetestLabelIndex := bar_index

if showRetest and retestShort and lastRetestLabelIndex != bar_index
    label.new(bar_index, high, fmt("RETEST ↓", "Bearish Retest"), style = label.style_label_down, color = colBear, textcolor = color.white, size = size.tiny)
    lastRetestLabelIndex := bar_index

// ============================================================================
// FVGs — price-attached zones
// ============================================================================
bullFvg = not na(high[2]) and low > high[2] and low - high[2] >= safeAtr * fvgMinAtr
bearFvg = not na(low[2]) and high < low[2] and low[2] - high >= safeAtr * fvgMinAtr

if confirmed and showFvg and bullFvg
    b = box.new(bar_index - 2, low, bar_index + fvgExtend, high[2], bgcolor = color.new(colFvgBull, 88), border_color = color.new(colFvgBull, 45))
    array.unshift(fvgZones, Zone.new(b, low, high[2], bar_index, true, true))
    if showFvgLabel
        label.new(bar_index - 1, (low + high[2]) / 2, fmt("FVG", "Fair Value Gap"), style = label.style_none, textcolor = colFvgBull, size = size.tiny)

if confirmed and showFvg and bearFvg
    b = box.new(bar_index - 2, low[2], bar_index + fvgExtend, high, bgcolor = color.new(colFvgBear, 88), border_color = color.new(colFvgBear, 45))
    array.unshift(fvgZones, Zone.new(b, low[2], high, bar_index, false, true))
    if showFvgLabel
        label.new(bar_index - 1, (low[2] + high) / 2, fmt("FVG", "Fair Value Gap"), style = label.style_none, textcolor = colFvgBear, size = size.tiny)

if array.size(fvgZones) > 0
    for i = array.size(fvgZones) - 1 to 0
        z = array.get(fvgZones, i)
        if z.active
            box.set_right(z.id, bar_index + fvgExtend)
            filled = z.bullish ? low <= z.bottom : high >= z.top
            if removeFilledFvg and filled
                box.delete(z.id)
                z.active := false
                array.set(fvgZones, i, z)

// ============================================================================
// Order blocks — last opposing candle before displacement.
// ============================================================================
body = math.abs(close - open)
bullImpulse = close > open and close - open >= safeAtr * obImpulseAtr
bearImpulse = close < open and open - close >= safeAtr * obImpulseAtr

if confirmed and showOb and bullImpulse
    int obBar = na
    for i = 1 to obLookback
        if close[i] < open[i]
            obBar := i
            break
    if not na(obBar)
        top = high[obBar]
        bottom = low[obBar]
        b = box.new(bar_index - obBar, top, bar_index + obExtend, bottom, bgcolor = color.new(colObBull, 90), border_color = color.new(colObBull, 55))
        array.unshift(obZones, Zone.new(b, top, bottom, bar_index, true, true))
        if showObLabel
            label.new(bar_index - obBar, bottom, fmt("Bullish OB", "Bullish Order Block"), style = label.style_label_up, color = color.new(colObBull, 25), textcolor = color.white, size = size.tiny)

if confirmed and showOb and bearImpulse
    int obBar = na
    for i = 1 to obLookback
        if close[i] > open[i]
            obBar := i
            break
    if not na(obBar)
        top = high[obBar]
        bottom = low[obBar]
        b = box.new(bar_index - obBar, top, bar_index + obExtend, bottom, bgcolor = color.new(colObBear, 90), border_color = color.new(colObBear, 55))
        array.unshift(obZones, Zone.new(b, top, bottom, bar_index, false, true))
        if showObLabel
            label.new(bar_index - obBar, top, fmt("Bearish OB", "Bearish Order Block"), style = label.style_label_down, color = color.new(colObBear, 25), textcolor = color.white, size = size.tiny)

if array.size(obZones) > 0
    for i = array.size(obZones) - 1 to 0
        z = array.get(obZones, i)
        if z.active
            box.set_right(z.id, bar_index + obExtend)

// ============================================================================
// Liquidity pools and sweeps
// ============================================================================
newHighPool = false
newLowPool = false

if showLiquidity and confirmed and not na(ph)
    for i = 1 to math.min(array.size(highs) - 1, maxStructure - 1)
        h = array.get(highs, i)
        if math.abs(h.price - ph) <= safeAtr * eqToleranceAtr
            newHighPool := true
            lineId = line.new(h.time, h.price, time, h.price, xloc = xloc.bar_time, extend = extend.none, color = color.new(colNeutral, 35), style = line.style_dashed, width = 1)
            array.unshift(pools, Pool.new(lineId, (h.price + ph) / 2.0, bar_index, true, false, true))
            break

if showLiquidity and confirmed and not na(pl)
    for i = 1 to math.min(array.size(lows) - 1, maxStructure - 1)
        l = array.get(lows, i)
        if math.abs(l.price - pl) <= safeAtr * eqToleranceAtr
            newLowPool := true
            lineId = line.new(l.time, l.price, time, l.price, xloc = xloc.bar_time, extend = extend.none, color = color.new(colNeutral, 35), style = line.style_dashed, width = 1)
            array.unshift(pools, Pool.new(lineId, (l.price + pl) / 2.0, bar_index, false, false, true))
            break

if array.size(pools) > 0
    for i = array.size(pools) - 1 to 0
        p = array.get(pools, i)
        if p.active
            line.set_x2(p.id, time)
            if bar_index - p.born > liqMaxAge
                line.delete(p.id)
                p.active := false
            else if p.highPool and high > p.price
                p.swept := true
                if showSweeps
                    label.new(bar_index, high, fmt("BSL SWEEP", "Buy-side Liquidity Sweep"), style = label.style_label_down, color = color.new(colStructure, 25), textcolor = color.white, size = size.tiny)
                line.delete(p.id)
                p.active := false
            else if not p.highPool and low < p.price
                p.swept := true
                if showSweeps
                    label.new(bar_index, low, fmt("SSL SWEEP", "Sell-side Liquidity Sweep"), style = label.style_label_up, color = color.new(colStructure, 25), textcolor = color.white, size = size.tiny)
                line.delete(p.id)
                p.active := false
            array.set(pools, i, p)

// ============================================================================
// Dealing range / equilibrium
// ============================================================================
if bosUp
    dealingLow := protectedLevel
    dealingHigh := brokenHighPrice
if bosDn
    dealingHigh := protectedLevel
    dealingLow := brokenLowPrice

if showRange and not na(dealingHigh) and not na(dealingLow)
    eq = (dealingHigh + dealingLow) / 2.0
    if na(equilibriumLine)
        equilibriumLine := line.new(bar_index, eq, bar_index + 1, eq, color = color.new(colNeutral, 45), style = line.style_dotted, width = 1)
    else
        line.set_xy1(equilibriumLine, bar_index, eq)
        line.set_xy2(equilibriumLine, bar_index + 1, eq)

premium = not na(dealingHigh) and not na(dealingLow) ? (dealingHigh + dealingLow) / 2.0 : na
if showZones and not na(premium)
    bgcolor(close >= premium ? color.new(colBear, 94) : color.new(colBull, 94))

// ============================================================================
// Optional swing points
// ============================================================================
plotshape(showSwingPoints and not na(ph), title = "Swing High", style = shape.triangledown, location = location.abovebar, offset = -pivotLen, size = size.tiny, color = colNeutral)
plotshape(showSwingPoints and not na(pl), title = "Swing Low", style = shape.triangleup, location = location.belowbar, offset = -pivotLen, size = size.tiny, color = colNeutral)

// Protected level remains a thin price overlay rather than a separate pane.
plot(showProtected ? protectedLevel : na, title = "Protected Level", color = color.new(colStructure, 20), linewidth = 1, style = plot.style_linebr)

// ============================================================================
// Alerts
// ============================================================================
alertcondition(bosUp, "Bullish BOS", "Bullish structure break")
alertcondition(bosDn, "Bearish BOS", "Bearish structure break")
alertcondition(chochUp, "Bullish CHoCH", "Bullish change of character")
alertcondition(chochDn, "Bearish CHoCH", "Bearish change of character")
alertcondition(retestLong, "Bullish Retest", "Bullish protected-level retest")
alertcondition(retestShort, "Bearish Retest", "Bearish protected-level retest")