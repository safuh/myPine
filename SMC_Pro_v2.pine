//@version=6

indicator("SMC Pro v2", "SMC Pro v2", overlay = true, max_lines_count = 500, max_boxes_count = 300, max_labels_count = 300)

// ============================================================================
// SMC Pro v2
// State-driven structure engine. The important distinction from the prototype
// is that a BOS creates a retest opportunity; a retest cannot exist before a
// break, and it expires/invalidates explicitly.
// ============================================================================

gStructure = "01. Structure"
pivotLen = input.int(2, "Fractal length", minval = 1, maxval = 10, group = gStructure)
confirmMode = input.string("Close", "Break confirmation", options = ["Close", "Wick"], group = gStructure)
atrLen = input.int(14, "ATR length", minval = 1, group = gStructure)
breakAtr = input.float(0.10, "Break buffer (ATR)", minval = 0, step = 0.01, group = gStructure)
maxStructure = input.int(100, "Structure history", minval = 20, maxval = 200, group = gStructure)
showStructure = input.bool(true, "Show BOS / CHoCH", group = gStructure)

// Retest is deliberately separated from break confirmation.
gRetest = "02. Retest"
showRetest = input.bool(true, "Show retests", group = gRetest)
retestToleranceAtr = input.float(0.20, "Retest zone tolerance (ATR)", minval = 0, step = 0.01, group = gRetest, tooltip = "Allows a valid retest when price remains slightly above/below the protected level.")
retestInvalidAtr = input.float(0.20, "Retest invalidation (ATR)", minval = 0, step = 0.01, group = gRetest, tooltip = "Maximum penetration beyond the protected level before the retest setup is invalidated.")
retestMaxBars = input.int(30, "Retest window (bars)", minval = 1, maxval = 200, group = gRetest)
requireRejection = input.bool(true, "Require rejection close", group = gRetest)

// FVG
gFvg = "03. Fair Value Gaps"
showFvg = input.bool(true, "Show FVGs", group = gFvg)
fvgMinAtr = input.float(0.10, "Minimum FVG size (ATR)", minval = 0, step = 0.01, group = gFvg)
fvgExtend = input.int(30, "FVG extension", minval = 1, maxval = 200, group = gFvg)
removeFilled = input.bool(true, "Remove filled FVGs", group = gFvg)

// Order blocks
gOb = "04. Order Blocks"
showOb = input.bool(true, "Show order blocks", group = gOb)
obLookback = input.int(12, "OB lookback", minval = 1, maxval = 50, group = gOb)
obImpulseAtr = input.float(0.50, "Minimum displacement (ATR)", minval = 0, step = 0.05, group = gOb)
obExtend = input.int(40, "OB extension", minval = 1, maxval = 200, group = gOb)

// Liquidity
gLiq = "05. Liquidity"
showLiquidity = input.bool(true, "Show liquidity pools", group = gLiq)
showSweeps = input.bool(true, "Show sweeps", group = gLiq)
eqToleranceAtr = input.float(0.12, "Equal high/low tolerance (ATR)", minval = 0, step = 0.01, group = gLiq)
liqMaxAge = input.int(150, "Maximum liquidity age", minval = 10, maxval = 1000, group = gLiq)

// Dealing range
gRange = "06. Dealing Range"
showRange = input.bool(true, "Show premium / discount", group = gRange)

atr = ta.atr(atrLen)
confirmed = barstate.isconfirmed
safeAtr = math.max(nz(atr, syminfo.mintick), syminfo.mintick)

breakUp(float level) =>
    confirmMode == "Close" ? close > level + safeAtr * breakAtr : high > level + safeAtr * breakAtr

breakDn(float level) =>
    confirmMode == "Close" ? close < level - safeAtr * breakAtr : low < level - safeAtr * breakAtr

// ============================================================================
// Types
// ============================================================================
type Swing
    float price
    int time
    int index
    bool broken
    bool protected
    bool invalidated
    int breakIndex
    int breakTime
    float breakPrice

type Zone
    box id
    float top
    float bottom
    int born
    bool bullish
    bool active

type Pool
    line id
    float price
    int born
    bool highPool
    bool swept
    bool active

// ============================================================================
// State
// ============================================================================
var array<Swing> highs = array.new<Swing>()
var array<Swing> lows = array.new<Swing>()
var array<Zone> fvgZones = array.new<Zone>()
var array<Zone> obZones = array.new<Zone>()
var array<Pool> pools = array.new<Pool>()

var int bias = 0
var float protectedLevel = na
var int protectedTime = na
var int protectedIndex = na
var int protectedSourceBreakIndex = na

// Retest state machine:
// 0 = idle, 1 = bullish setup active, -1 = bearish setup active.
var int retestState = 0
var int retestStartIndex = na
var bool retestTouched = false
var bool retestDone = false

var int lastBrokenHighIndex = na
var int lastBrokenLowIndex = na
var int lastSignalIndex = na

bosUp = false
bosDn = false
chochUp = false
chochDn = false
retestLong = false
retestShort = false

// ============================================================================
// Confirmed pivots
// ============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if confirmed and not na(ph)
    array.unshift(highs, Swing.new(ph, time[pivotLen], bar_index - pivotLen, false, false, false, na, na, na))
    if array.size(highs) > maxStructure
        array.pop(highs)

if confirmed and not na(pl)
    array.unshift(lows, Swing.new(pl, time[pivotLen], bar_index - pivotLen, false, false, false, na, na, na))
    if array.size(lows) > maxStructure
        array.pop(lows)

// ============================================================================
// Structure event detection
// ============================================================================
// One event is emitted per direction per bar. If both sides break on the same
// confirmed candle, the older structural candidate wins; this prevents the
// final bias from being an accidental consequence of loop ordering.
highBreak = false
lowBreak = false
highBreakAge = na
lowBreakAge = na

if confirmed and array.size(highs) > 0
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if not s.broken and not s.invalidated and breakUp(s.price)
            highBreak := true
            highBreakAge := bar_index - s.index
            break

if confirmed and array.size(lows) > 0
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if not s.broken and not s.invalidated and breakDn(s.price)
            lowBreak := true
            lowBreakAge := bar_index - s.index
            break

// Deterministic tie-breaker for rare dual breaks.
processHigh = highBreak and (not lowBreak or highBreakAge <= lowBreakAge)
processLow = lowBreak and (not highBreak or lowBreakAge < highBreakAge)

if processHigh
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if not s.broken and not s.invalidated and breakUp(s.price)
            s.broken := true
            s.breakIndex := bar_index
            s.breakTime := time
            s.breakPrice := confirmMode == "Close" ? close : high
            array.set(highs, i, s)
            bosUp := true
            chochUp := bias < 0
            bias := 1
            lastBrokenHighIndex := i
            break

if processLow
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if not s.broken and not s.invalidated and breakDn(s.price)
            s.broken := true
            s.breakIndex := bar_index
            s.breakTime := time
            s.breakPrice := confirmMode == "Close" ? close : low
            array.set(lows, i, s)
            bosDn := true
            chochDn := bias > 0
            bias := -1
            lastBrokenLowIndex := i
            break

// ============================================================================
// Protected swing + retest setup creation
// ============================================================================
// For a bullish break, the protected swing is the newest confirmed low that
// existed before the break and has not itself been invalidated. Conversely for
// a bearish break we select the newest qualifying high. This is tied to the
// actual break event, not to a global "last BOS" timestamp.
if bosUp
    protectedLevel := na
    protectedTime := na
    protectedIndex := na
    for i = 0 to array.size(lows) - 1
        s = array.get(lows, i)
        if s.time < time and not s.invalidated
            protectedLevel := s.price
            protectedTime := s.time
            protectedIndex := s.index
            protectedSourceBreakIndex := bar_index
            s.protected := true
            array.set(lows, i, s)
            break
    retestState := not na(protectedLevel) ? 1 : 0
    retestStartIndex := bar_index
    retestTouched := false
    retestDone := false

if bosDn
    protectedLevel := na
    protectedTime := na
    protectedIndex := na
    for i = 0 to array.size(highs) - 1
        s = array.get(highs, i)
        if s.time < time and not s.invalidated
            protectedLevel := s.price
            protectedTime := s.time
            protectedIndex := s.index
            protectedSourceBreakIndex := bar_index
            s.protected := true
            array.set(highs, i, s)
            break
    retestState := not na(protectedLevel) ? -1 : 0
    retestStartIndex := bar_index
    retestTouched := false
    retestDone := false

// A retest is a POST-break event. It is not allowed on the BOS candle.
if confirmed and retestState != 0 and bar_index > retestStartIndex and not retestDone
    barsInWindow = bar_index - retestStartIndex
    tolerance = safeAtr * retestToleranceAtr
    invalidation = safeAtr * retestInvalidAtr

    if barsInWindow > retestMaxBars or (retestState == 1 and close < protectedLevel - invalidation) or (retestState == -1 and close > protectedLevel + invalidation)
        retestState := 0
    else if retestState == 1
        // Long retest accepts a touch slightly ABOVE the protected price.
        // It also permits a controlled undershoot, but not an arbitrary break.
        touched = low <= protectedLevel + tolerance and low >= protectedLevel - invalidation
        rejected = not requireRejection or close > protectedLevel
        if touched
            retestTouched := true
        if retestTouched and rejected
            retestLong := true
            retestDone := true
            retestState := 0
    else
        // Short retest accepts a touch slightly BELOW the protected price.
        touched = high >= protectedLevel - tolerance and high <= protectedLevel + invalidation
        rejected = not requireRejection or close < protectedLevel
        if touched
            retestTouched := true
        if retestTouched and rejected
            retestShort := true
            retestDone := true
            retestState := 0

// ============================================================================
// Protected-level invalidation after the setup exists
// ============================================================================
if confirmed and bias == 1 and not na(protectedLevel) and retestState != 0
    if breakDn(protectedLevel)
        retestState := 0
        if not na(protectedIndex)
            for i = 0 to array.size(lows) - 1
                s = array.get(lows, i)
                if s.index == protectedIndex
                    s.invalidated := true
                    s.protected := false
                    array.set(lows, i, s)
                    break

if confirmed and bias == -1 and not na(protectedLevel) and retestState != 0
    if breakUp(protectedLevel)
        retestState := 0
        if not na(protectedIndex)
            for i = 0 to array.size(highs) - 1
                s = array.get(highs, i)
                if s.index == protectedIndex
                    s.invalidated := true
                    s.protected := false
                    array.set(highs, i, s)
                    break

if showStructure and bosUp
    label.new(bar_index, high, chochUp ? "CHoCH ↑" : "BOS ↑", style = label.style_label_down, color = chochUp ? color.orange : color.green, textcolor = color.white, size = size.tiny)
if showStructure and bosDn
    label.new(bar_index, low, chochDn ? "CHoCH ↓" : "BOS ↓", style = label.style_label_up, color = chochDn ? color.orange : color.red, textcolor = color.white, size = size.tiny)

// ============================================================================
// FVG lifecycle
// ============================================================================
bullFvg = not na(high[2]) and low > high[2] and low - high[2] >= safeAtr * fvgMinAtr
bearFvg = not na(low[2]) and high < low[2] and low[2] - high >= safeAtr * fvgMinAtr

if confirmed and showFvg and bullFvg
    b = box.new(bar_index - 2, low, bar_index + fvgExtend, high[2], bgcolor = color.new(color.green, 88), border_color = color.new(color.green, 35))
    array.unshift(fvgZones, Zone.new(b, low, high[2], bar_index, true, true))
if confirmed and showFvg and bearFvg
    b = box.new(bar_index - 2, low[2], bar_index + fvgExtend, high, bgcolor = color.new(color.red, 88), border_color = color.new(color.red, 35))
    array.unshift(fvgZones, Zone.new(b, low[2], high, bar_index, false, true))

if array.size(fvgZones) > 80
    z = array.pop(fvgZones)
    box.delete(z.id)

if array.size(fvgZones) > 0
    for i = array.size(fvgZones) - 1 to 0
        z = array.get(fvgZones, i)
        if z.active
            filled = z.bullish ? low <= z.bottom : high >= z.top
            expired = bar_index - z.born > fvgExtend
            if filled or expired
                if removeFilled or expired
                    box.delete(z.id)
                    array.remove(fvgZones, i)
                else
                    z.active := false
                    array.set(fvgZones, i, z)

// ============================================================================
// Order blocks — created only from a structural displacement candle.
// ============================================================================
if confirmed and showOb and (bosUp or bosDn)
    bull = bosUp
    impulse = bull ? close - open : open - close
    if impulse >= safeAtr * obImpulseAtr
        found = na
        for j = 1 to obLookback
            opposite = bull ? close[j] < open[j] : close[j] > open[j]
            if opposite
                found := j
                break
        if not na(found)
            top = high[found]
            bottom = low[found]
            b = box.new(bar_index - found, top, bar_index + obExtend, bottom, bgcolor = bull ? color.new(color.green, 90) : color.new(color.red, 90), border_color = bull ? color.new(color.green, 45) : color.new(color.red, 45))
            array.unshift(obZones, Zone.new(b, top, bottom, bar_index - found, bull, true))

if array.size(obZones) > 40
    z = array.pop(obZones)
    box.delete(z.id)
if array.size(obZones) > 0
    for i = array.size(obZones) - 1 to 0
        z = array.get(obZones, i)
        if z.active
            invalid = z.bullish ? close < z.bottom : close > z.top
            expired = bar_index - z.born > obExtend
            if invalid or expired
                box.delete(z.id)
                array.remove(obZones, i)

// ============================================================================
// Equal highs/lows and one-shot sweeps
// ============================================================================
if confirmed and not na(ph) and array.size(highs) > 1
    lim = math.min(array.size(highs) - 1, 8)
    for i = 1 to lim
        old = array.get(highs, i)
        if math.abs(ph - old.price) <= safeAtr * eqToleranceAtr and bar_index - old.index <= liqMaxAge
            if showLiquidity
                l = line.new(old.time, old.price, time[pivotLen], ph, xloc = xloc.bar_time, color = color.new(color.red, 25), style = line.style_dashed)
                array.unshift(pools, Pool.new(l, ph, bar_index, true, false, true))
            break

if confirmed and not na(pl) and array.size(lows) > 1
    lim = math.min(array.size(lows) - 1, 8)
    for i = 1 to lim
        old = array.get(lows, i)
        if math.abs(pl - old.price) <= safeAtr * eqToleranceAtr and bar_index - old.index <= liqMaxAge
            if showLiquidity
                l = line.new(old.time, old.price, time[pivotLen], pl, xloc = xloc.bar_time, color = color.new(color.green, 25), style = line.style_dashed)
                array.unshift(pools, Pool.new(l, pl, bar_index, false, false, true))
            break

if array.size(pools) > 60
    p = array.pop(pools)
    line.delete(p.id)

sweepHigh = false
sweepLow = false
if confirmed and showSweeps and array.size(pools) > 0
    for i = array.size(pools) - 1 to 0
        p = array.get(pools, i)
        if p.active and not p.swept and bar_index - p.born <= liqMaxAge
            if p.highPool and high > p.price and close < p.price
                p.swept := true
                line.set_x2(p.id, time)
                array.set(pools, i, p)
                sweepHigh := true
            else if not p.highPool and low < p.price and close > p.price
                p.swept := true
                line.set_x2(p.id, time)
                array.set(pools, i, p)
                sweepLow := true

if sweepHigh and showSweeps
    label.new(bar_index, high, "BSL sweep ↓", style = label.style_label_down, color = color.red, textcolor = color.white, size = size.tiny)
if sweepLow and showSweeps
    label.new(bar_index, low, "SSL sweep ↑", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.tiny)

// ============================================================================
// Premium / discount: active structural dealing range, not simply the newest
// high and newest low. Use the protected level plus the broken extreme when a
// structure event exists; otherwise use the latest confirmed opposite pivots.
// ============================================================================
var line eqLine = na
rangeHigh = na
rangeLow = na
if bias == 1 and not na(protectedLevel) and not na(lastBrokenHighIndex)
    rangeLow := protectedLevel
    rangeHigh := array.get(highs, lastBrokenHighIndex).price
else if bias == -1 and not na(protectedLevel) and not na(lastBrokenLowIndex)
    rangeHigh := protectedLevel
    rangeLow := array.get(lows, lastBrokenLowIndex).price

if showRange and not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
    equilibrium = (rangeHigh + rangeLow) / 2.0
    if na(eqLine)
        eqLine := line.new(bar_index, equilibrium, bar_index + 1, equilibrium, extend = extend.right, color = color.new(color.gray, 55), style = line.style_dotted)
    else
        line.set_xy1(eqLine, bar_index, equilibrium)
        line.set_xy2(eqLine, bar_index + 1, equilibrium)

// ============================================================================
// Visual pivots and retest signals
// ============================================================================
plotshape(not na(ph), title = "Swing High", style = shape.triangledown, location = location.abovebar, offset = -pivotLen, size = size.tiny, color = color.new(color.red, 25))
plotshape(not na(pl), title = "Swing Low", style = shape.triangleup, location = location.belowbar, offset = -pivotLen, size = size.tiny, color = color.new(color.green, 25))

if showRetest and retestLong and lastSignalIndex != bar_index
    label.new(bar_index, low, "LONG RETEST", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
    lastSignalIndex := bar_index
if showRetest and retestShort and lastSignalIndex != bar_index
    label.new(bar_index, high, "SHORT RETEST", style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
    lastSignalIndex := bar_index

plot(protectedLevel, title = "Protected Level", color = color.new(color.yellow, 20), linewidth = 1, style = plot.style_linebr)

alertcondition(bosUp, "Bullish BOS", "SMC Pro v2: bullish BOS")
alertcondition(bosDn, "Bearish BOS", "SMC Pro v2: bearish BOS")
alertcondition(chochUp, "Bullish CHoCH", "SMC Pro v2: bullish CHoCH")
alertcondition(chochDn, "Bearish CHoCH", "SMC Pro v2: bearish CHoCH")
alertcondition(retestLong, "Bullish Retest", "SMC Pro v2: bullish protected-level retest")
alertcondition(retestShort, "Bearish Retest", "SMC Pro v2: bearish protected-level retest")
alertcondition(sweepLow, "Sell-side Liquidity Sweep", "SMC Pro v2: sell-side liquidity swept")
alertcondition(sweepHigh, "Buy-side Liquidity Sweep", "SMC Pro v2: buy-side liquidity swept")
